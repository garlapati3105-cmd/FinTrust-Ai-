# FinTrust AI — Backend Configuration Template
# Copy this file to .env and configure your local or test credentials.
# NEVER commit .env or actual API secrets into version control.

# OpenRouter AI Model Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
FINTRUST_EXTRACTION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Document Upload & Security Constraints
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=10

# API protection. In production, set the same random secret in the backend
# and the frontend server environment (never NEXT_PUBLIC_*).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINTRUST_ENV=development
FINTRUST_API_KEY=

# Comma-separated allowed browser origins for direct API clients.
# The Next.js server-side proxy is same-origin and does not require CORS.
FINTRUST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database Configuration (Defaults to backend/fintrust.db)
# FINTRUST_DB_PATH=fintrust.db
